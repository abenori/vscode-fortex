{
  "name": "vscode-fortex",
  "displayName": "vscode-fortex",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abenori/vscode-fortex.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing and navigation remain available, but builds, PDF previews, SyncTeX, SumatraPDF, and kpsewhich execution are disabled until the workspace is trusted."
    }
  },
  "activationEvents": [
    "onLanguage:latex",
    "onCommand:vscode-fortex.viewPdf",
    "onCommand:vscode-fortex.viewPdfInVSCode",
    "onCommand:vscode-fortex.viewPdfInSumatraPDF",
    "onCommand:vscode-fortex.syncTeXFromCursor",
    "onCommand:vscode-fortex.insertCitation",
    "onCommand:vscode-fortex.insertOrRenameEnvironment",
    "onCommand:vscode-fortex.closeEnvironment",
    "onCommand:vscode-fortex.goToCorresponding"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "aliases": [
          "LaTeX"
        ],
        "extensions": [
          ".tex"
        ]
      }
    ],
    "commands": [
      {
        "command": "vscode-fortex.build",
        "title": "Build LaTeX Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdf",
        "title": "View LaTeX PDF",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdfInVSCode",
        "title": "View LaTeX PDF in VS Code",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdfInSumatraPDF",
        "title": "View LaTeX PDF in SumatraPDF",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.syncTeXFromCursor",
        "title": "SyncTeX from Cursor",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.insertCitation",
        "title": "Insert Citation",
        "category": "Fortex"
      },
      {
        "command": "vscode-fortex.insertOrRenameEnvironment",
        "title": "Insert or Rename LaTeX Environment",
        "category": "Fortex"
      },
      {
        "command": "vscode-fortex.closeEnvironment",
        "title": "Close Unclosed LaTeX Environment",
        "category": "Fortex"
      },
      {
        "command": "vscode-fortex.goToCorresponding",
        "title": "Go to Corresponding LaTeX Command",
        "category": "Fortex"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-fortex.build",
        "key": "ctrl+t t",
        "when": "editorTextFocus && editorLangId == latex && isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdf",
        "key": "ctrl+t p",
        "when": "editorLangId == latex && isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.syncTeXFromCursor",
        "key": "ctrl+t j",
        "when": "editorTextFocus && editorLangId == latex && isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.insertCitation",
        "key": "ctrl+t [",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "vscode-fortex.insertOrRenameEnvironment",
        "key": "ctrl+t b",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "vscode-fortex.closeEnvironment",
        "key": "ctrl+t e",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "vscode-fortex.goToCorresponding",
        "key": "ctrl+t g",
        "when": "editorTextFocus && editorLangId == latex"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "fortex",
      "properties": {
        "vscode-fortex.mainFileOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["magic", "guess", "current"]
          },
          "default": [
            "magic",
            "guess",
            "current"
          ],
          "markdownDescription": "Priority order used to find the main LaTeX file: `magic` reads `%#main`, `guess` searches ancestor directories for a document that recursively includes the current file, and `current` uses the current file."
        },
        "vscode-fortex.compileTrigger": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "onSave"
          ],
          "description": "Trigger for compiling the LaTeX document."
        },
        "vscode-fortex.compile.allowedPrograms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "tex",
            "pdftex",
            "luatex",
            "xetex",
            "ptex",
            "uptex",
            "latex",
            "pdflatex",
            "lualatex",
            "xelatex",
            "platex",
            "uplatex",
            "dvipdfmx",
            "dvispk",
            "bibtex",
            "upbibtex",
            "biber",
            "mendex",
            "makeindex",
            "upmendex"
          ],
          "scope": "machine",
          "order": 10,
          "markdownDescription": "Programs that source-file `%#` directives may execute. Program names are matched exactly. Add `*` as an array item to permit any program. This restriction does not apply to programs selected without a `%#` directive."
        },
        "vscode-fortex.compile.maxLaTeXRuns": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "scope": "machine",
          "order": 11,
          "markdownDescription": "Maximum number of LaTeX runs allowed for a single build. Set to `0` to allow unlimited runs. This limit is applied to the number of LaTeX runs, not the total number of compilation runs, which may include BibTeX or Biber runs."
        },
        "vscode-fortex.pdfViewer": {
          "type": "string",
          "enum": ["internal", "sumatra"],
          "enumDescriptions": [
            "Open PDFs in the VS Code internal viewer.",
            "Open PDFs in SumatraPDF."
          ],
          "default": "internal",
          "order": 20,
          "markdownDescription": "PDF viewer used by **View LaTeX PDF** (`Ctrl+T P`). Select `internal` for the VS Code viewer or `sumatra` for SumatraPDF."
        },
        "vscode-fortex.openPdfAfterBuild": {
          "type": "boolean",
          "default": false,
          "description": "Open the configured PDF viewer after a successful build. An already open internal preview is always refreshed."
        },
        "vscode-fortex.sumatraPDF.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 30,
          "markdownDescription": "Full path to `SumatraPDF.exe`, for example `C:\\Program Files\\SumatraPDF\\SumatraPDF.exe`. Leave empty to detect a standard installation or use `PATH`."
        },
        "vscode-fortex.sumatraPDF.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["-reuse-instance"],
          "scope": "machine",
          "order": 31,
          "description": "Additional command-line arguments passed to SumatraPDF."
        },
        "vscode-fortex.sumatraPDF.inverseSearch.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 32,
          "description": "Enable inverse SyncTeX search from SumatraPDF back to VS Code."
        },
        "vscode-fortex.sumatraPDF.inverseSearch.vscodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 33,
          "markdownDescription": "Path to the VS Code executable used by SumatraPDF inverse search. Leave empty to use the currently running VS Code executable. The generated command is `\"<path>\" -r -g \"%f:%l\"`."
        },
        "vscode-fortex.synctex.path": {
          "type": "string",
          "default": "synctex",
          "scope": "machine",
          "description": "SyncTeX command used for forward and reverse search."
        },
        "vscode-fortex.synctex.forwardSearch.focus": {
          "type": "string",
          "enum": ["editor", "viewer"],
          "enumDescriptions": [
            "Keep focus in the source editor after forward search.",
            "Move focus to the PDF viewer after forward search."
          ],
          "default": "editor",
          "order": 40,
          "markdownDescription": "Focus destination after **SyncTeX from Cursor** (`Ctrl+T J`). Applies to both the internal viewer and SumatraPDF."
        },
        "vscode-fortex.kpsewhich.path": {
          "type": "string",
          "default": "kpsewhich",
          "scope": "machine",
          "description": "kpsewhich command used to resolve bibliography files through the Kpathsea search path."
        },
        "vscode-fortex.environment.indentContent": {
          "type": "boolean",
          "default": true,
          "order": 50,
          "markdownDescription": "Indent content by one editor indentation level when Fortex inserts or wraps a LaTeX environment. The indentation width and tabs/spaces follow the standard `editor.tabSize` and `editor.insertSpaces` settings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node ./scripts/copy-pdfjs.mjs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "pdfjs-dist": "^5.4.149"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
