{
  "name": "vscode-fortex",
  "displayName": "vscode-fortex",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abenori/vscode-fortex.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing and navigation remain available, but builds, PDF previews, SyncTeX, SumatraPDF, kpsewhich, and texdoc execution are disabled until the workspace is trusted."
    }
  },
  "activationEvents": [
    "onLanguage:latex",
    "onView:fortex.structure",
    "onCommand:vscode-fortex.viewPdf",
    "onCommand:vscode-fortex.viewPdfInVSCode",
    "onCommand:vscode-fortex.viewPdfInSumatraPDF",
    "onCommand:vscode-fortex.syncTeXFromCursor",
    "onCommand:vscode-fortex.openDocumentation",
    "onCommand:vscode-fortex.insertCitation",
    "onCommand:vscode-fortex.insertOrRenameEnvironment",
    "onCommand:vscode-fortex.closeEnvironment",
    "onCommand:vscode-fortex.goToCorresponding"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "aliases": [
          "LaTeX"
        ],
        "extensions": [
          ".tex"
        ]
      }
    ],
    "views": {
      "explorer": [{ "id": "fortex.structure", "name": "LaTeX Structure" }]
    },
    "menus": {
      "view/title": [
        { "command": "vscode-fortex.outline.searchLabels", "when": "view == fortex.structure", "group": "navigation@2" },
        { "command": "vscode-fortex.outline.filter", "when": "view == fortex.structure", "group": "navigation@3" },
        { "command": "vscode-fortex.outline.toggleMode", "when": "view == fortex.structure", "group": "1_display@1" },
        { "command": "vscode-fortex.outline.toggleLabels", "when": "view == fortex.structure", "group": "1_display@2" },
        { "command": "vscode-fortex.outline.toggleLabeledOnly", "when": "view == fortex.structure", "group": "1_display@3" }
      ],
      "view/item/context": [
        { "command": "vscode-fortex.outline.goToLabel", "when": "view == fortex.structure && (viewItem == fortex.structure.node.labeled || viewItem == fortex.structure.label)", "group": "navigation@1" }
      ],
      "commandPalette": [
        { "command": "vscode-fortex.outline.open", "when": "false" },
        { "command": "vscode-fortex.outline.goToLabel", "when": "false" }
      ]
    },
    "commands": [
      { "command": "vscode-fortex.outline.searchLabels", "title": "Go to LaTeX Label", "category": "Fortex", "icon": "$(search)" },
      { "command": "vscode-fortex.outline.filter", "title": "Filter LaTeX Structure", "category": "Fortex", "icon": "$(filter)" },
      { "command": "vscode-fortex.outline.toggleMode", "title": "Show Labels in Name Order", "category": "Fortex", "toggled": "fortex.structure.labelMode" },
      { "command": "vscode-fortex.outline.toggleLabels", "title": "Show Attached Label Names", "category": "Fortex", "toggled": "fortex.structure.showLabels" },
      { "command": "vscode-fortex.outline.toggleLabeledOnly", "title": "Show Only Labeled Items", "category": "Fortex", "toggled": "fortex.structure.labeledOnly" },
      { "command": "vscode-fortex.outline.open", "title": "Go to Structure Source", "category": "Fortex" },
      { "command": "vscode-fortex.outline.goToLabel", "title": "Go to Attached Label", "category": "Fortex" },
      {
        "command": "vscode-fortex.build",
        "title": "Build LaTeX Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdf",
        "title": "View LaTeX PDF",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdfInVSCode",
        "title": "View LaTeX PDF in VS Code",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdfInSumatraPDF",
        "title": "View LaTeX PDF in SumatraPDF",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.syncTeXFromCursor",
        "title": "SyncTeX from Cursor",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.openDocumentation",
        "title": "Open Documentation",
        "category": "Fortex",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.insertCitation",
        "title": "Insert Citation",
        "category": "Fortex"
      },
      {
        "command": "vscode-fortex.insertOrRenameEnvironment",
        "title": "Insert or Rename LaTeX Environment",
        "category": "Fortex"
      },
      {
        "command": "vscode-fortex.closeEnvironment",
        "title": "Close Unclosed LaTeX Environment",
        "category": "Fortex"
      },
      {
        "command": "vscode-fortex.goToCorresponding",
        "title": "Go to Corresponding LaTeX Command",
        "category": "Fortex"
      },
      {
        "command": "vscode-fortex.greekCompletion.start",
        "title": "Insert Greek Letter",
        "category": "Fortex",
        "enablement": "editorLangId == latex && !editorReadonly"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-fortex.build",
        "key": "ctrl+t t t",
        "when": "editorTextFocus && editorLangId == latex && isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.viewPdf",
        "key": "ctrl+t t p",
        "when": "editorLangId == latex && isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.syncTeXFromCursor",
        "key": "ctrl+t t j",
        "when": "editorTextFocus && editorLangId == latex && isWorkspaceTrusted"
      },
      {
        "command": "vscode-fortex.openDocumentation",
        "key": "ctrl+t i c",
        "when": "editorTextFocus && editorLangId == latex && isWorkspaceTrusted && !isComposing"
      },
      {
        "command": "vscode-fortex.insertCitation",
        "key": "ctrl+t [",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "vscode-fortex.insertOrRenameEnvironment",
        "key": "ctrl+t b",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "vscode-fortex.closeEnvironment",
        "key": "ctrl+t e",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "vscode-fortex.goToCorresponding",
        "key": "ctrl+t g",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "vscode-fortex.greekCompletion.start",
        "key": "ctrl+t j",
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && !isComposing"
      },
      {
        "command": "vscode-fortex.greekCompletion.commit",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && fortex.greekCompletionActive && !isComposing"
      },
      {
        "command": "vscode-fortex.greekCompletion.commit",
        "key": "space",
        "args": {
          "text": " "
        },
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && fortex.greekCompletionActive && !isComposing"
      },
      {
        "command": "vscode-fortex.greekCompletion.cancel",
        "key": "escape",
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && fortex.greekCompletionActive && !isComposing"
      },
      {
        "command": "vscode-fortex.greekCompletion.backspace",
        "key": "backspace",
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && fortex.greekCompletionActive && !isComposing"
      },
      {
        "command": "vscode-fortex.greekCompletion.showCandidates",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && fortex.greekCompletionActive && !isComposing"
      },
      {
        "command": "vscode-fortex.greekCompletion.cancel",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && fortex.greekCompletionActive && !isComposing"
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+t x a",
        "args": {
          "snippet": "\\mathcal{a}$0"
        },
        "when": "editorTextFocus && editorLangId == latex && !editorReadonly && config.vscode-fortex.mathShortcuts.enabled"
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+t x shift+a",
        "args": {
          "snippet": "\\mathcal{A}$0"
