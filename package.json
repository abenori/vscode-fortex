    "configuration": {
      "type": "object",
      "title": "fortex",
      "properties": {
        "vscode-fortex.completion.label.scope": {
          "type": "string",
          "enum": ["document", "project"],
          "default": "document",
          "scope": "resource",
          "enumDescriptions": ["Collect labels from the current document.", "Collect labels from the main document and its recursive input/include files."],
          "description": "Source scope for label completion. Unsaved editor contents are used."
        },
        "vscode-fortex.completion.command.scope": {
          "type": "string",
          "enum": ["document", "project"],
          "default": "document",
          "scope": "resource",
          "enumDescriptions": ["Collect command definitions from the current document.", "Collect command definitions from the main document and its recursive input/include files."],
          "description": "Source scope for user-defined command completion. The fixed command catalog is always available."
        },
        "vscode-fortex.completion.environment.scope": {
          "type": "string",
          "enum": ["document", "project"],
          "default": "document",
          "scope": "resource",
          "enumDescriptions": ["Collect environment names from the current document.", "Collect environment names from the main document and its recursive input/include files."],
          "description": "Source scope for environment completion. The fixed environment catalog is always available."
        },
        "vscode-fortex.mainFileOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["magic", "guess", "current"]
          },
          "default": [
            "magic",
            "guess",
            "current"
          ],
          "markdownDescription": "Priority order used to find the main LaTeX file: `magic` reads `%#main`, `guess` searches ancestor directories for a document that recursively includes the current file, and `current` uses the current file."
        },
        "vscode-fortex.compileTrigger": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "onSave"
          ],
          "description": "Trigger for compiling the LaTeX document."
        },
        "vscode-fortex.compile.allowedPrograms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "tex",
            "pdftex",
            "luatex",
            "xetex",
            "ptex",
            "uptex",
            "latex",
            "pdflatex",
            "lualatex",
            "xelatex",
            "platex",
            "uplatex",
            "dvipdfmx",
            "dvispk",
            "bibtex",
            "upbibtex",
            "biber",
            "mendex",
            "makeindex",
            "upmendex"
          ],
          "scope": "machine",
          "order": 10,
          "markdownDescription": "Programs that source-file `%#` directives may execute. Program names are matched exactly. Add `*` as an array item to permit any program. This restriction does not apply to programs selected without a `%#` directive."
        },
        "vscode-fortex.compile.maxLaTeXRuns": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "scope": "machine",
          "order": 11,
          "markdownDescription": "Maximum number of LaTeX runs allowed for a single build. Set to `0` to allow unlimited runs. This limit is applied to the number of LaTeX runs, not the total number of compilation runs, which may include BibTeX or Biber runs."
        },
        "vscode-fortex.pdfViewer": {
          "type": "string",
          "enum": ["internal", "sumatra"],
          "enumDescriptions": [
            "Open PDFs in the VS Code internal viewer.",
            "Open PDFs in SumatraPDF."
          ],
          "default": "internal",
          "order": 20,
          "markdownDescription": "PDF viewer used by **View LaTeX PDF** (`Ctrl+T T P`). Select `internal` for the VS Code viewer or `sumatra` for SumatraPDF."
        },
        "vscode-fortex.openPdfAfterBuild": {
          "type": "boolean",
          "default": false,
          "description": "Open the configured PDF viewer after a successful build. An already open internal preview is always refreshed."
        },
        "vscode-fortex.sumatraPDF.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 30,
          "markdownDescription": "Full path to `SumatraPDF.exe`, for example `C:\\Program Files\\SumatraPDF\\SumatraPDF.exe`. Leave empty to detect a standard installation or use `PATH`."
        },
        "vscode-fortex.sumatraPDF.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["-reuse-instance"],
          "scope": "machine",
          "order": 31,
          "description": "Additional command-line arguments passed to SumatraPDF."
        },
        "vscode-fortex.sumatraPDF.inverseSearch.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 32,
          "description": "Enable inverse SyncTeX search from SumatraPDF back to VS Code."
        },
        "vscode-fortex.sumatraPDF.inverseSearch.vscodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 33,
          "markdownDescription": "Path to the VS Code executable used by SumatraPDF inverse search. Leave empty to use the currently running VS Code executable. The generated command is `\"<path>\" -r -g \"%f:%l\"`."
        },
        "vscode-fortex.synctex.path": {
          "type": "string",
          "default": "synctex",
          "scope": "machine",
          "description": "SyncTeX command used for forward and reverse search."
        },
        "vscode-fortex.synctex.forwardSearch.focus": {
          "type": "string",
          "enum": ["editor", "viewer"],
          "enumDescriptions": [
            "Keep focus in the source editor after forward search.",
            "Move focus to the PDF viewer after forward search."
          ],
          "default": "editor",
          "order": 40,
          "markdownDescription": "Focus destination after **SyncTeX from Cursor** (`Ctrl+T T J`). Applies to both the internal viewer and SumatraPDF."
        },
        "vscode-fortex.kpsewhich.path": {
          "type": "string",
          "default": "kpsewhich",
          "scope": "machine",
          "description": "kpsewhich command used to resolve bibliography files through the Kpathsea search path."
        },
        "vscode-fortex.texdoc.path": {
          "type": "string",
          "default": "texdoc",
          "scope": "machine",
          "markdownDescription": "TeX Live `texdoc` executable used by **Fortex: Open Documentation** (`Ctrl+T I C`). Set a full executable path if `texdoc` is not on `PATH`."
        },
        "vscode-fortex.environment.indentContent": {
          "type": "boolean",
          "default": true,
          "order": 50,
          "markdownDescription": "Indent content by one editor indentation level when Fortex inserts or wraps a LaTeX environment. The indentation width and tabs/spaces follow the standard `editor.tabSize` and `editor.insertSpaces` settings."
        },
        "vscode-fortex.outline.followIncludes": {
          "type": "boolean", "default": true, "scope": "window",
          "markdownDescription": "Use the build's main-file detection and recursively expand literal `\\input` / `\\include` commands in the LaTeX Structure view. Disable to show only the current file. Does not change build behavior."
        },
        "vscode-fortex.outline.theoremEnvironments": {
          "type": "object", "default": {}, "scope": "window",
          "additionalProperties": { "type": "string" },
          "markdownDescription": "Additional theorem-like environment names and their display names, for example `{\"claim\": \"Claim\"}`. Declarations using `\\newtheorem` in parsed TeX sources are discovered automatically."
        },
        "vscode-fortex.outline.visibleKinds": {
          "type": "array", "default": ["section", "theorem", "figure", "table", "label"], "scope": "window",
          "items": { "type": "string", "enum": ["section", "theorem", "figure", "table", "label"] },
          "uniqueItems": true,
          "description": "Categories displayed in the structure tree. Equations are controlled separately. Hidden parents promote visible children."
        },
        "vscode-fortex.outline.equations": {
          "type": "string", "enum": ["labeled", "all", "hidden"], "default": "labeled", "scope": "window",
          "description": "Display labeled equations, all display equations, or no equations in the structure tree."
        },
        "vscode-fortex.outline.showLabels": {
          "type": "boolean", "default": true, "scope": "window",
          "description": "Show attached label names next to structure items."
        },
        "vscode-fortex.outline.labeledOnly": {
          "type": "boolean", "default": false, "scope": "window",
          "description": "Show only labeled structure items and their heading ancestors."
        },
        "vscode-fortex.outline.viewMode": {
          "type": "string", "enum": ["structure", "labels"], "default": "structure", "scope": "window",
          "description": "Show the document hierarchy or a complete list of labels sorted by name. Label mode ignores category filters."
        },
        "vscode-fortex.mathShortcuts.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "order": 60,
          "markdownDescription": "Enable math alphabet shortcuts in LaTeX editors: `Ctrl+T X` followed by a letter inserts `\\mathcal{...}`, and `Ctrl+T F` followed by a letter inserts `\\mathfrak{...}`. Use Shift to enter uppercase letters."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node ./scripts/copy-pdfjs.mjs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
